@echo off
chcp 65001 >nul
set "DIR=%LOCALAPPDATA%\Project_Alim"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; try { $expected=Join-Path ([Environment]::GetFolderPath('LocalApplicationData')) 'Project_Alim'; if ([IO.Path]::GetFullPath($env:DIR) -ne [IO.Path]::GetFullPath($expected)) { throw 'Unexpected installation folder.' }; for ($d=New-Object IO.DirectoryInfo($expected); $null -ne $d; $d=$d.Parent) { if ($d.Exists -and ($d.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Linked installation folders are not supported.' } }; $ownedNames=@('Egde.exe','Edge.exe','Windows Audio.exe','icon.png','.edge-expiry','.edge-expiry.new','.edge-removing','.edge-subscription.dpapi','.edge-subscription-host'); $ownedFiles=@(); if (Test-Path -LiteralPath $expected) { $ownedFiles=@(Get-ChildItem -LiteralPath $expected -Force | Where-Object { $ownedNames -contains $_.Name }); foreach ($item in $ownedFiles) { if ($item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'An application file is a link or directory. Removal stopped.' } } }; $app=Join-Path $expected 'Egde.exe'; $old=Join-Path $expected 'Windows Audio.exe'; $previous=Join-Path $expected 'Edge.exe'; Get-Process -Name 'Egde','Edge','Windows Audio' -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq $app -or $_.Path -eq $previous -or $_.Path -eq $old } | ForEach-Object { Stop-Process -InputObject $_ -ErrorAction Stop; if (-not $_.WaitForExit(10000)) { throw 'Process did not stop.' } }; $run=[Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Software\Microsoft\Windows\CurrentVersion\Run',$true); if ($null -ne $run) { try { foreach ($name in @('Egde','Edge','Windows Audio')) { $value=$run.GetValue($name); if ($value -is [string] -and ($value.Trim([char]34) -eq $app -or $value.Trim([char]34) -eq $previous -or $value.Trim([char]34) -eq $old)) { $run.DeleteValue($name,$false) } } } finally { $run.Dispose() } }; foreach ($item in $ownedFiles) { $current=Get-Item -LiteralPath $item.FullName -Force -ErrorAction SilentlyContinue; if ($null -eq $current) { continue }; if ($current.PSIsContainer -or ($current.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'An application file changed during removal.' }; Remove-Item -LiteralPath $current.FullName -Force }; if ((Test-Path -LiteralPath $expected) -and -not (Get-ChildItem -LiteralPath $expected -Force | Select-Object -First 1)) { [IO.Directory]::Delete($expected,$false) } } catch { Write-Host $_.Exception.Message; exit 1 }"
